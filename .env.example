# ---- core -----------------------------------------------------------------
# Public hostname (used by docker-compose for TLS, TURN realm and links)
DOMAIN=call.example.com
PORT=3000
# Absolute base URL used in embed links and billing redirects
PUBLIC_URL=https://call.example.com
# Signs session tokens. Generate with: openssl rand -hex 32
BB_SECRET=
# Enables /admin and /metrics. Generate with: openssl rand -hex 24
BB_ADMIN_TOKEN=
# Optional separate token for Prometheus scraping of /metrics
BB_METRICS_TOKEN=
# Where workspaces and usage aggregates are stored
BB_DATA_DIR=./data
# Set to 1 to keep nothing on disk (tenants are lost on restart)
BB_EPHEMERAL=0
# Number of trusted reverse proxies in front of the app (for client IPs)
BB_TRUST_PROXY=1

# ---- networking --------------------------------------------------------------
# Comma-separated STUN servers. Point at your own to avoid third parties.
BB_STUN_URLS=stun:call.example.com:3478
# Built-in STUN responder port (0 = disabled). Not needed if coturn runs.
BB_STUN_PORT=0
# TURN relay (coturn with use-auth-secret). Enables "Hide my IP".
BB_TURN_URLS=turn:call.example.com:3478?transport=udp,turns:call.example.com:5349?transport=tcp
BB_TURN_SECRET=
BB_TURN_TTL=3600
# Extra origins allowed to open the WebSocket (comma-separated)
BB_ALLOWED_ORIGINS=
# Origins allowed to frame /embed for every workspace (comma-separated)
BB_EMBED_ORIGINS=

# ---- SaaS ----------------------------------------------------------------------
# Let anyone create a free workspace from /dashboard
BB_OPEN_SIGNUP=0
# JSON overrides for plan limits, e.g. {"pro":{"maxPeers":8}}
BB_PLANS=
BB_BRAND_NAME=BinaryBond
# Allow webhooks to private IPs (only for testing)
BB_ALLOW_PRIVATE_WEBHOOKS=0

# ---- Stripe billing (optional) --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---- abuse limits -------------------------------------------------------------
BB_WS_PER_IP_PER_MIN=60
BB_JOINS_PER_IP_PER_MIN=30
BB_HTTP_PER_IP_PER_MIN=300
BB_MAX_CONNS_PER_IP=40
BB_MAX_ROOMS=20000
